PORT=4000
JWT_SECRET=change-me-in-production
DB_PATH=./data.sqlite3

# S3-compatible storage for ownership-proof verification documents (see "File
# storage" in backend/README.md). Required in production — without these,
# application uploads fail with a 500.
#
# Using Cloudflare R2 (this project's setup): set S3_ENDPOINT to your R2
# account's S3 API endpoint, leave AWS_REGION as "auto", and use an R2 API
# token's Access Key ID / Secret Access Key (Cloudflare dashboard -> R2 ->
# Manage R2 API Tokens -> scope it to just this bucket, Object Read & Write).
#
# Using real AWS S3 instead: omit S3_ENDPOINT and set AWS_REGION to your
# bucket's actual region (e.g. ap-southeast-1).
AWS_REGION=auto
AWS_S3_BUCKET=propgather-verification-docs
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
