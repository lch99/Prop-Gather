PORT=4000
JWT_SECRET=change-me-in-production

# Browser origins allowed to call this API, comma-separated. The frontend is a
# separate origin in every deployment shape (Vite dev server, GitHub Pages, or a
# domain fronted by nginx), so this has to list it or the browser blocks every
# request and the app shows empty pages.
#
# Unset, only the local dev origins are allowed (http://localhost:5173 and
# http://127.0.0.1:5173) — development works untouched, and an unconfigured
# server fails closed instead of allowing the whole internet. `*` restores
# allow-anything explicitly. The effective list is printed at boot.
#
#   CORS_ORIGINS=https://propgather.com,https://lch99.github.io
# CORS_ORIGINS=

# MySQL 8. The database is created automatically if the user has CREATE
# privileges (see src/db/migrate.js); otherwise create it first:
#   CREATE DATABASE propgather CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=propgather
MYSQL_PASSWORD=
MYSQL_DATABASE=propgather
# Connections held open by the pool. The app is a single Node process, so this
# is the ceiling on concurrent queries — raising it past MySQL's max_connections
# just moves the queue from the app to the server.
MYSQL_POOL_SIZE=10

# Demo data — six fictional projects and accounts whose passwords are in this
# repo's README (admin@propgather.com / admin123 among them). Local development
# only. NEVER set this on a server: a production database must start empty, and
# its first admin comes from `npm run create-admin` instead.
SEED_DEMO_DATA=true

# S3-compatible storage for ownership-proof verification documents (see "File
# storage" in backend/README.md). Required in production — without these,
# application uploads fail with a 500.
#
# Using Cloudflare R2 (this project's setup): set S3_ENDPOINT to your R2
# account's S3 API endpoint, leave AWS_REGION as "auto", and use an R2 API
# token's Access Key ID / Secret Access Key (Cloudflare dashboard -> R2 ->
# Manage R2 API Tokens -> scope it to just this bucket, Object Read & Write).
#
# Using real AWS S3 instead: omit S3_ENDPOINT and set AWS_REGION to your
# bucket's actual region (e.g. ap-southeast-1).
AWS_REGION=auto
AWS_S3_BUCKET=propgather-verification-docs
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
