# Frontend build-time configuration. Copy to `.env.local` for local development.
#
# Vite inlines VITE_* variables into the bundle at BUILD time — they are not read
# at runtime. Changing one means rebuilding and redeploying, and anything here
# ends up readable in the shipped JavaScript, so never put a secret in this file.

# Where the backend API lives, including the /api prefix and no trailing slash.
#
# Defaults if unset:
#   dev  (npm run dev)   -> http://localhost:4000/api
#   prod (npm run build) -> /api   (same origin; correct when a reverse proxy
#                                  serves the frontend and proxies /api to
#                                  Express — see VPS_SETUP.md)
#
# Set it explicitly whenever the frontend and API aren't same-origin, which
# includes the GitHub Pages demo:
#   VITE_API_URL=https://api.your-domain.com/api
VITE_API_URL=http://localhost:4000/api

# Shows the "Demo logins" panel on the login page, which prints the seeded
# credentials from backend/src/db/seed.js. Those accounts only exist in a
# database seeded with SEED_DEMO_DATA=true.
#
# Defaults to on in `npm run dev` and OFF in a production build. Only set this to
# true for a build you intend to be a public demo — never for a real deployment.
# VITE_SHOW_DEMO_LOGINS=false
